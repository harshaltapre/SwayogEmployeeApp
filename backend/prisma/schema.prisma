generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

generator client_backend {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                            @id @default(uuid())
  loginId                    String                            @unique
  employeeCode               String?                           @unique
  email                      String                            @unique
  phoneNumber                String?                           @unique
  fullName                   String
  passwordHash               String
  role                       UserRole                          @default(CUSTOMER)
  designationTitle           String?
  departmentId               String?
  reportingManagerId         String?
  isActive                   Boolean                           @default(true)
  failedLoginAttempts        Int                               @default(0)
  lockoutUntil               DateTime?
  lastFailedLoginAt          DateTime?
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  portalPassword             String?
  profileImageUrl            String?
  permissions                String[]                          @default([])
  advances                   Advance[]
  assignedAmcVisits          AmcVisit[]                        @relation("assigned_amc_employee")
  attendanceCorrections      AttendanceCorrection[]
  AttendanceRecord           AttendanceRecord[]
  attendanceRequests         AttendanceRegularizationRequest[] @relation("employee_attendance_requests")
  reviewedAttendanceRequests AttendanceRegularizationRequest[] @relation("admin_reviewed_requests")
  auditLogs                  AuditLog[]                        @relation("audit_actor")
  checkIns                   CheckIn[]
  customerProfile            Customer?
  dailyCommits               DailyCommit[]
  employeeNotifications      EmployeeNotification[]
  employeeProfile            EmployeeProfile?
  faceEnrollment             FaceEnrollment?
  imageRecords               ImageRecord[]
  incentives                 Incentive[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  MarketingCampaign          MarketingCampaign[]
  MarketingFollowUp          MarketingFollowUp[]
  MarketingLead              MarketingLead[]
  receivedMessages           Message[]                         @relation("ReceivedMessages")
  sentMessages               Message[]                         @relation("SentMessages")
  OnboardingAuditLog         OnboardingAuditLog[]
  OnboardingRequest          OnboardingRequest[]
  OnboardingSiteVisit        OnboardingSiteVisit[]
  overtimeRequests           OvertimeRequest[]
  overtimeSessions           OvertimeSession[]
  partnerProfile             PartnerProfile?
  PerformanceSnapshot        PerformanceSnapshot[]
  refreshTokens              RefreshToken[]
  salaryRecords              SalaryRecord[]
  salaryRevisions            SalaryRevision[]
  createdTasks               Task[]                            @relation("task_creator")
  assignedTasks              Task[]                            @relation("task_employee")
  taskAssignees              TaskAssignee[]
  taskAssignments            TaskAssignment[]
  taskImages                 TaskImage[]
  department                 Department?                       @relation(fields: [departmentId], references: [id])
  reportingManager           User?                             @relation("user_reporting", fields: [reportingManagerId], references: [id])
  directReports              User[]                            @relation("user_reporting")
  workSubmissions            WorkSubmission[]
  liaisoning_applications    liaisoning_applications[]
  liaisoning_audit_logs      liaisoning_audit_logs[]

  @@index([lockoutUntil])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@index([role, departmentId])
}

model Department {
  id          String         @id @default(uuid())
  code        DepartmentCode @unique
  name        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       User[]
}

model Task {
  id                    Int              @id @default(autoincrement())
  jobType               String
  description           String
  customerName          String
  customerPhone         String
  address               String
  latitude              Float?
  longitude             Float?
  status                TaskStatus       @default(ASSIGNED)
  scheduledTime         DateTime
  employeeUserId        String
  assignedById          String
  completionMessage     String?
  completionDocumentUrl String?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  sitePhotos            String[]         @default([])
  afterImageUrl         String?
  afterLatitude         Float?
  afterLongitude        Float?
  beforeImageUrl        String?
  beforeLatitude        Float?
  beforeLongitude       Float?
  customerFeedback      String?
  customerId            Int?
  customerRating        Int?
  fixCharges            Float?
  taskRate              Float?
  taskType              String           @default("REGULAR")
  maintenanceVideos     String[]         @default([])
  photoRemarks          Json?
  imageRecords          ImageRecord[]
  payments              Payment[]
  assignedBy            User             @relation("task_creator", fields: [assignedById], references: [id], onDelete: Cascade)
  customer              Customer?        @relation(fields: [customerId], references: [id])
  employee              User             @relation("task_employee", fields: [employeeUserId], references: [id], onDelete: Cascade)
  taskAssignees         TaskAssignee[]
  taskAssignments       TaskAssignment[]
  taskImages            TaskImage[]
  workSubmissions       WorkSubmission[]

  @@index([customerId])
  @@index([taskType])
  @@index([employeeUserId])
  @@index([assignedById])
  @@index([status])
  @@index([scheduledTime])
  @@index([employeeUserId, status])
  @@index([employeeUserId, scheduledTime])
}

model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    Int
  userId    String
  role      String?
  status    String   @default("assigned")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model ImageRecord {
  id             String    @id @default(uuid())
  taskId         Int
  uploadedBy     String
  type           String
  url            String
  watermarkedUrl String?
  exif           Json?
  latitude       Float?
  longitude      Float?
  takenAt        DateTime?
  createdAt      DateTime  @default(now())
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedBy])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("audit_actor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId, action])
}

model PartnerProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  businessName   String?
  serviceZone    String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  partnerCode    String?           @unique
  customers      Customer[]
  employees      EmployeeProfile[]
  Invoice        Invoice[]
  PartnerInstall PartnerInstall[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeProfile {
  id               String          @id @default(uuid())
  userId           String          @unique
  partnerId        String?
  jobRole          String          @default("field_technician")
  zone             String?
  monthlySalaryInr Int?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  permissions      String[]        @default([])
  partner          PartnerProfile? @relation(fields: [partnerId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([userId])
}

model Customer {
  id                      Int                      @id @default(autoincrement())
  customerCode            String                   @unique
  fullName                String
  email                   String
  phoneNumber             String
  city                    String
  address                 String
  systemSizeKw            Float
  installationDate        DateTime
  warrantyExpiry          DateTime?
  panelBrand              String?
  inverterBrand           String?
  amcStatus               CustomerAmcStatus        @default(NONE)
  amcExpiryDate           DateTime?
  status                  CustomerStatus           @default(ACTIVE)
  partnerId               String?
  userId                  String?                  @unique
  projectStage            Int                      @default(11)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cleaningWindow1         String?                  @default("1-10")
  cleaningWindow2         String?                  @default("11-20")
  cleaningWindow3         String?                  @default("21-30")
  cleaningsPerMonth       Int?                     @default(1)
  clientType              String?                  @default("post_paid")
  consumerNumber          String?
  contractEndDate         DateTime?
  contractStartDate       DateTime?
  monthlyCleaningRate     Float?
  paymentTerms            String?
  remarks                 String?
  cleaningWindow4         String?
  cleaningWindow5         String?
  cleaningWindow6         String?
  cleaningWindow7         String?
  cleaningWindow8         String?
  assignedEmployeeId      String?
  commissionAmount        Float?
  commissionStatus        CommissionStatus         @default(PENDING)
  commissionProofUrl      String?
  commissionPaidAt        DateTime?
  inverterLoginId         String?
  inverterPassword        String?
  portalPassword          String?
  inverterApiKey          String?
  inverterDeviceSn        String?
  inverterModel           String?
  latitude                Float?
  longitude               Float?
  apartmentId             Int?
  projectType             String?
  state                   String?
  partnerLeadStatus       String?                  @default("PENDING")
  assignedEpc             String?
  epcAssignmentStatus     String?
  dataLoggerSrNo          String?
  inverterName            String?
  inverterSrNo            String?
  inverterUid             String?
  monitoringLastDataAt    DateTime?
  monitoringLastError     String?
  monitoringLastSyncAt    DateTime?
  monitoringPlantId       String?
  monitoringPortalUrl     String?
  monitoringProvider      String?
  monitoringStatus        String?
  documentsCollected      Boolean                  @default(false)
  isRejected              Boolean                  @default(false)
  rejectionReason         String?
  siteVisitCompleted      Boolean                  @default(false)
  solarSystemInstalled    Boolean                  @default(false)
  AmcContract             AmcContract[]
  AmcVisit                AmcVisit[]
  apartment               Apartment?               @relation(fields: [apartmentId], references: [id])
  partner                 PartnerProfile?          @relation(fields: [partnerId], references: [id])
  user                    User?                    @relation(fields: [userId], references: [id])
  notifications           CustomerNotification[]
  dispatchRecords         DispatchRecord[]
  inverterCache           InverterCache?
  Invoice                 Invoice[]
  OnboardingRequest       OnboardingRequest[]
  payments                Payment[]
  serviceRequests         ServiceRequest[]
  tasks                   Task[]
  generationLogs          GenerationLog[]
  inverterInstallations   InverterInstallation[]
  liaisoning_applications liaisoning_applications?
  waareeGeneration        WaareeGeneration?

  @@index([partnerId])
  @@index([status])
  @@index([amcStatus])
}

model Apartment {
  id        Int        @id @default(autoincrement())
  name      String
  address   String
  city      String     @default("Pune")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
}

model ServiceRequest {
  id            Int                  @id @default(autoincrement())
  customerId    Int
  title         String
  description   String
  address       String?
  latitude      Float?
  longitude     Float?
  scheduledDate String?
  scheduledTime String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  status        ServiceRequestStatus @default(PENDING)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
}

model AmcContract {
  id           String   @id
  customerId   Int
  state        String
  annualFeeInr Int
  startDate    DateTime
  renewalDate  DateTime
  isActive     Boolean  @default(true)
  isRenewed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([renewalDate])
  @@index([state])
}

model Expense {
  id          String   @id
  category    String
  amount      Int
  expenseDate DateTime
  zone        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@index([expenseDate])
}

model Invoice {
  id             String               @id @default(uuid())
  customerId     Int
  amount         Float
  amountPaid     Float                @default(0)
  invoiceDate    DateTime             @default(now())
  paymentDate    DateTime?
  zone           String?
  state          String?
  partnerId      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  description    String?
  paymentMethod  String?
  proofUrl       String?
  invoiceNumber  String?
  invoiceType    InvoiceType          @default(INSTALLATION)
  paymentStatus  InvoicePaymentStatus @default(PENDING)
  Customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  PartnerProfile PartnerProfile?      @relation(fields: [partnerId], references: [id])

  @@index([customerId])
  @@index([invoiceDate])
  @@index([partnerId])
  @@index([paymentStatus])
  @@index([zone])
  @@index([partnerId, invoiceDate])
  @@index([customerId, invoiceDate])
}

model PartnerInstall {
  id             String         @id
  partnerId      String
  invoiceId      String
  installDate    DateTime
  commissionInr  Int
  createdAt      DateTime       @default(now())
  PartnerProfile PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([partnerId])
}

model AmcVisit {
  id                    String         @id @default(uuid())
  customerId            Int
  scheduledDate         DateTime
  completedAt           DateTime?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  assignedEmployeeId    String?
  cleaningNumber        Int?
  completedByEmployeeId String?
  completedByName       String?
  timeSlot              String?
  visitNotes            String?
  afterImageUrl         String?
  beforeImageUrl        String?
  status                AmcVisitStatus @default(PENDING)
  maintenanceVideos     String[]       @default([])
  photoRemarks          Json?
  assignedEmployee      User?          @relation("assigned_amc_employee", fields: [assignedEmployeeId], references: [id])
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([scheduledDate])
  @@index([status])
  @@index([assignedEmployeeId])
  @@index([assignedEmployeeId, status])
  @@index([assignedEmployeeId, scheduledDate])
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id                    String           @id @default(uuid())
  employeeId            String
  date                  DateTime         @db.Date
  checkInTime           DateTime?
  checkOutTime          DateTime?
  totalMinutes          Int?
  status                AttendanceStatus @default(PRESENT)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  flagged               Boolean          @default(false)
  manualOverride        Boolean          @default(false)
  overrideReason        String?
  reviewedBy            String?
  source                String?          @default("EMPLOYEE_CHECK_IN")
  overtimeMinutes       Int?             @default(0)
  displayAsSelfPunch    Boolean          @default(false)
  actualCheckOutTime    DateTime?
  effectiveCheckOutTime DateTime?
  checkOutSource        String?
  autoClosedAt          DateTime?
  autoClosureReason     String?
  employee              User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
  @@index([flagged])
  @@index([source])
  @@index([displayAsSelfPunch])
  @@index([checkOutSource])
}

model CheckIn {
  id               String        @id @default(cuid())
  employeeId       String
  selfieUrl        String?
  latitude         Float?
  longitude        Float?
  status           CheckInStatus @default(CHECKED_IN)
  createdAt        DateTime      @default(now())
  flagged          Boolean       @default(false)
  livenessVerified Boolean       @default(false)
  manualOverride   Boolean       @default(false)
  matchConfidence  Float?
  matchDistance    Float?
  overrideReason   String?
  reviewedBy       String?
  employee         User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([createdAt])
  @@index([flagged])
}

model AdminNotification {
  id         String   @id @default(cuid())
  type       String
  message    String
  imageUrl   String?
  employeeId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([type])
  @@index([createdAt])
}

model FaceEnrollment {
  id               String    @id @default(uuid())
  employeeId       String    @unique
  descriptor1      Json
  descriptor2      Json
  descriptor3      Json
  enrolledAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  modelVersion     String    @default("face-api-ssd-mobilenetv1-v1")
  deletedAt        DateTime?
  /// Which platform created/last-updated this enrollment. "WEB" | "MOBILE"
  enrollmentSource String    @default("WEB")
  /// Soft-delete flag. Set to true instead of hard-deleting so mobile sync can
  /// detect the deletion via the /face/sync endpoint.
  isDeleted        Boolean   @default(false)
  /// Monotonically incremented on every upsert. Mobile compares its local version
  /// to the server version to detect when a re-download is needed.
  syncVersion      Int       @default(1)
  webDescriptor1   Json?
  webDescriptor2   Json?
  webDescriptor3   Json?
  webModelVersion  String?
  webEnrolledAt    DateTime?
  employee         User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([updatedAt])
}

model PerformanceSnapshot {
  id                 String   @id @default(uuid())
  employeeId         String
  month              Int
  year               Int
  attendancePercent  Float    @default(0)
  taskCompletionRate Float    @default(0)
  avgWorkScore       Float    @default(0)
  totalHoursLogged   Float    @default(0)
  performanceScore   Float    @default(0)
  daysPresent        Int      @default(0)
  daysAbsent         Int      @default(0)
  tasksAssigned      Int      @default(0)
  tasksCompleted     Int      @default(0)
  workSubmissions    Int      @default(0)
  calculatedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  employee           User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
}

model WorkSubmission {
  id          String     @id @default(uuid())
  employeeId  String
  taskId      Int?
  title       String
  description String
  proofUrl    String?
  proofNotes  String?
  hoursSpent  Float      @default(0)
  submittedAt DateTime   @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewScore Int?
  reviewNotes String?
  status      WorkStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  employee    User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model DailyCommit {
  id             String   @id @default(uuid())
  employeeId     String
  taskWorkedOn   String
  workSummary    String
  hoursSpent     Float
  issuesBlockers String?
  attachmentUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  commitDate     DateTime @db.Date
  submittedAt    DateTime @default(now())
  tomorrowPlan   String?
  employee       User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, commitDate])
  @@index([employeeId])
  @@index([commitDate])
}

model Inventory {
  id           Int                   @id @default(autoincrement())
  sku          String                @unique
  name         String
  category     String
  inStock      Int                   @default(0)
  minThreshold Int                   @default(0)
  supplier     String?
  pricePerUnit Float                 @default(0)
  entryDate    DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  company      String?
  unit         String                @default("unit")
  capacityKw   String?
  dispatches   DispatchRecord[]
  stockEntries InventoryStockEntry[]
}

model InventoryStockEntry {
  id               Int                   @id @default(autoincrement())
  itemId           Int
  quantity         Int
  entryDate        DateTime
  pricePerUnit     Float
  supplier         String?
  createdAt        DateTime              @default(now())
  movementType     InventoryMovementType @default(IN)
  dispatchedTo     String?
  notes            String?
  previousQuantity Int                   @default(0)
  newQuantity      Int                   @default(0)
  transactionType  String                @default("ADD")
  remarks          String?
  createdBy        String?
  item             Inventory             @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, entryDate])
}

model DispatchRecord {
  id           String    @id @default(uuid())
  customerId   Int
  itemId       Int
  quantity     Int
  dispatchedAt DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item         Inventory @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([itemId])
}

model GrowattCustomer {
  id            Int                 @id @default(autoincrement())
  customerName  String              @map("customer_name")
  plantId       String              @unique @map("plant_id")
  plantName     String              @map("plant_name")
  plantCapacity Float               @map("plant_capacity")
  plantLocation String              @map("plant_location")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  apiToken      String              @map("api_token")
  inverterSn    String?             @map("inverter_sn")
  generations   GrowattGeneration[]

  @@map("growatt_customers")
}

model GrowattGeneration {
  id                Int             @id @default(autoincrement())
  growattCustomerId Int             @map("growatt_customer_id")
  todayGeneration   Float           @default(0) @map("today_generation")
  monthlyGeneration Float           @default(0) @map("monthly_generation")
  yearlyGeneration  Float           @default(0) @map("yearly_generation")
  totalGeneration   Float           @default(0) @map("total_generation")
  currentPower      Float           @default(0) @map("current_power")
  status            String          @default("offline")
  lastUpdated       DateTime        @default(now()) @map("last_updated")
  growattCustomer   GrowattCustomer @relation(fields: [growattCustomerId], references: [id], onDelete: Cascade)

  @@index([growattCustomerId])
  @@map("growatt_generations")
}

model WaareeGeneration {
  id                Int      @id @default(autoincrement())
  customerId        Int      @unique @map("customer_id")
  todayGeneration   Float    @default(0) @map("today_generation")
  monthlyGeneration Float    @default(0) @map("monthly_generation")
  yearlyGeneration  Float    @default(0) @map("yearly_generation")
  totalGeneration   Float    @default(0) @map("total_generation")
  currentPower      Float    @default(0) @map("current_power")
  status            String   @default("offline")
  lastUpdated       DateTime @default(now()) @map("last_updated")
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("waaree_generations")
}

model InverterCache {
  customerId  Int      @id
  summaryData Json
  updatedAt   DateTime @default(now()) @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  id             String               @id @default(uuid())
  taskId         Int
  employeeUserId String
  assignedAt     DateTime             @default(now())
  status         TaskAssignmentStatus @default(ASSIGNED)
  employee       User                 @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeUserId])
  @@index([taskId])
  @@index([employeeUserId])
  @@index([status])
}

model CustomerNotification {
  id         String   @id @default(uuid())
  customerId Int
  type       String
  message    String
  taskId     Int?
  imageUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

