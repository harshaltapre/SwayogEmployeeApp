{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npm install --prefix backend",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/.prisma/client/**,backend/node_modules/.prisma/client/**,backend/dist/vercel-app.cjs}"
    }
  },
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/latest.json",
      "destination": "/api/index.ts"
    },
    {
      "source": "/releases/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|app/|releases/|latest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
