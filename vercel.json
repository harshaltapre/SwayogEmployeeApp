{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npm install --prefix backend",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/.prisma/client/**,backend/node_modules/.prisma/client/**,backend/dist/vercel-app.cjs}"
    }
  },
  "rewrites": [
    {
      "source": "/latest.json",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|app/).*)",
      "destination": "/index.html"
    }
  ]
}
